{
    "name": "balance-api",
    "version": "1.0.0",
    "main": "src/app.js",
    "type": "module",
    "scripts": {
        "start": "node src/app.js",
        "migrate": "node src/migrations/index.js",
        "docker:up": "docker-compose up -d",
        "docker:down": "docker-compose down",
        "docker:logs": "docker-compose logs -f",
        "init": "npm run docker:up && sleep 5 && npm run migrate"
    },
    "dependencies": {
        "express": "^4.18.2",
        "pg": "^8.11.3",
        "pg-hstore": "^2.3.4",
        "sequelize": "^6.37.1",
        "umzug": "^3.7.0",
        "dotenv": "^16.4.5",
        "express-validator": "^7.0.1"
    },
    "devDependencies": {
        "node-fetch": "^3.3.2"
    }
}
